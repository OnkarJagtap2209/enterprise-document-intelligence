# Copy this file to .env for local development.
APP_ENV=development
DOCUMENT_DIR=data/documents
EXTRACTED_DIR=data/extracted
CHUNKS_DIR=data/chunks
CHROMA_DB_PATH=chroma_db
CHROMA_COLLECTION_NAME=enterprise_financial_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16
SEMANTIC_TOP_K=5
BM25_TOP_K=10
HYBRID_TOP_K=10
HYBRID_CANDIDATE_DEPTH=10
RRF_K=60
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_CANDIDATE_DEPTH=10
RERANKER_TOP_K=5
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
CONTEXT_MAX_CHARS=12000
OBSERVABILITY_ENABLED=true
TRACE_PERSISTENCE_ENABLED=false
RUNTIME_TRACE_PATH=data/traces/runtime.jsonl
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
CHUNK_MAX_CHARS=1600
CHUNK_OVERLAP_CHARS=200
LOG_LEVEL=INFO
